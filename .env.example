# ==========================================
# STUDYFORGE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Client Application URL (for CORS & Cookies)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# e.g., mongodb://127.0.0.1:27017/studyforge OR mongodb+srv://<user>:<password>@cluster.mongodb.net/studyforge
MONGODB_URI=mongodb://127.0.0.1:27017/studyforge

# JWT Authentication Secret
JWT_SECRET=studyforge_super_secure_jwt_secret_change_in_production_key_2026

# AI Provider Configuration
# Supported providers: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=mock

# Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Max Upload Size (in bytes, default: 10MB)
MAX_FILE_SIZE_BYTES=10485760
